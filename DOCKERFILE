# --- Build Stage ---
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Build the backend and frontend apps using Nx
RUN npx nx build backend --prod
RUN npx nx build frontend --prod

# --- Production Runner Stage ---
FROM node:18-alpine
WORKDIR /app
ENV NODE_ENV=production

# Install static file server for frontend and copy production assets
RUN npm install -g serve
COPY --from=builder /app/dist/apps/backend ./backend
COPY --from=builder /app/dist/apps/frontend ./frontend

# Install production dependencies for the backend
WORKDIR /app/backend
RUN npm install --omit=dev

EXPOSE 3000
EXPOSE 4200

# Start depending on hosting needs
CMD ["node", "main.js"]
